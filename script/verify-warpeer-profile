  arborium-xml \
  arborium-vue \
  arborium-dockerfile \
  arborium-jq
do
  if grep -Eq "^${forbidden_dependency}( |$)" "$dependency_tree"; then
    fail "forbidden dependency is present in the Warpeer closure: $forbidden_dependency"
  fi
done

cargo tree -p warp --features gui -e normal --prefix none > "$full_dependency_tree"
for required_full_dependency in \
  mermaid_to_svg \
  dagre_rust
do
  if ! grep -Eq "^${required_full_dependency}( |$)" "$full_dependency_tree"; then
    fail "full Warp dependency is missing: $required_full_dependency"
  fi
done
for warpeer_only_dependency in \
  pocketjs_adapter \
  warpeer_plugin_protocol \
  warpeer_plugin_runtime \
  warpeer_plugin_surface_transport \
  warpeer_plugin_worker
do
  if grep -Eq "^${warpeer_only_dependency}( |$)" "$full_dependency_tree"; then
    fail "Warpeer-only plugin dependency leaked into full Warp: $warpeer_only_dependency"
  fi
done

cargo tree -p warp --no-default-features --features warpeer -e features \
  -i warp-command-signatures --prefix none > "$warpeer_feature_tree"
cargo tree -p warp --features gui -e features -i warp-command-signatures --prefix none \
  > "$full_feature_tree"
if grep -Fq 'warp-command-signatures feature "embed-signatures"' "$warpeer_feature_tree"; then
  fail 'embedded cross-platform command signatures leaked into Warpeer'
fi
if ! grep -Fq 'warp-command-signatures feature "embed-signatures"' "$full_feature_tree"; then
  fail 'full Warp lost embedded command signatures'
fi

if awk '
  /fn is_available\(self\)/ { capture = 1 }
  /Stable identifier for this section/ { capture = 0 }
  capture
' app/src/settings_view/mod.rs | rg --quiet --fixed-strings 'Self::Privacy'; then
  fail 'Privacy is available in the terminal-only settings allowlist'
fi

for guarded_share_path in \
  app/src/pane_group/mod.rs \
  app/src/pane_group/pane/view/header/sharing.rs \
  app/src/pane_group/pane/view/mod.rs \
  app/src/terminal/view.rs \
  app/src/terminal/view/init.rs \
  app/src/terminal/view/shared_session/view_impl.rs
do
  require_match 'is_full_warp' "$guarded_share_path"
done

