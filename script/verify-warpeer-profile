#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"

fail() {
  echo "Warpeer product contract failed: $*" >&2
  exit 1
}

require_match() {
  local pattern="$1"
  local path="$2"
  rg --quiet --fixed-strings -- "$pattern" "$path" || fail "missing '$pattern' in $path"
}

require_regex() {
  local pattern="$1"
  local path="$2"
  rg --quiet --multiline -- "$pattern" "$path" || fail "missing regex '$pattern' in $path"
}

reject_match() {
  local pattern="$1"
  local path="$2"
  if rg --quiet --fixed-strings -- "$pattern" "$path"; then
    fail "unexpected '$pattern' in $path"
  fi
}

require_max_lines() {
  local maximum="$1"
  local path="$2"
  local lines
  lines="$(wc -l < "$path")"
  if (( lines > maximum )); then
    fail "$path has $lines lines; maximum is $maximum"
  fi
}

