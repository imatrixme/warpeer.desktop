  '*.p8' \
  '*.p12' \
  '*.mobileprovision' \
  '*.provisionprofile' \
  '*.keychain-db'
do
  git check-ignore -q "$ignored_signing_material" || \
    fail "signing material is not ignored: $ignored_signing_material"
done

if rg --quiet 'TillerWarp|tiller-warp|tiller_warp|dev\.tiller\.TillerWarp' \
  app/src/bin/warpeer.rs app/Cargo.toml app/src/app_menus.rs script/warpeer script/run-warpeer; then
  fail 'legacy TillerWarp branding remains in the Warpeer product surface'
fi

release_profile="$(awk '
  /^\[profile\.release-warpeer\]$/ { capture = 1; next }
  /^\[/ { capture = 0 }
  capture
' Cargo.toml)"
if grep -Eq 'panic[[:space:]]*=[[:space:]]*"abort"|opt-level[[:space:]]*=[[:space:]]*"[sz]"' \
  <<<"$release_profile"; then
  fail 'release-warpeer must preserve unwind semantics and release optimization'
fi

dependency_tree="$(mktemp)"
full_dependency_tree="$(mktemp)"
warpeer_feature_tree="$(mktemp)"
full_feature_tree="$(mktemp)"
trap 'rm -f -- "$dependency_tree" "$full_dependency_tree" "$warpeer_feature_tree" \
  "$full_feature_tree"' EXIT
cargo tree -p warp --no-default-features --features warpeer -e normal --prefix none \
  > "$dependency_tree"
for required_dependency in \
  pocketjs_adapter \
  warpeer_plugin_protocol \
  warpeer_plugin_runtime \
  warpeer_plugin_surface_transport \
  warpeer_plugin_worker
do
  if ! grep -Eq "^${required_dependency}( |$)" "$dependency_tree"; then
    fail "required plugin dependency is missing from the Warpeer closure: $required_dependency"
  fi
done
for forbidden_dependency in \
  app-installation-detection \
  aws-config \
  aws-credential-types \
