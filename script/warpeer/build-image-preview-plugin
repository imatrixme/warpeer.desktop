#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
plugin_root="$repo_root/plugins/image-preview"
revision="$(tr -d '[:space:]' < "$repo_root/third_party/pocketjs/PINNED_REVISION")"
checkout="${POCKETJS_SOURCE:-}"
temporary_roots=()

cleanup() {
  for root in "${temporary_roots[@]}"; do
    rm -rf -- "$root"
  done
}
trap cleanup EXIT

if [[ -z "$checkout" ]]; then
  checkout_root="$(mktemp -d)"
  temporary_roots+=("$checkout_root")
  checkout="$checkout_root/pocketjs"
  git clone --filter=blob:none --no-checkout https://github.com/pocket-stack/pocketjs.git "$checkout"
  git -C "$checkout" fetch --depth 1 origin "$revision"
  git -C "$checkout" checkout --detach "$revision"
fi

resolved="$(git -C "$checkout" rev-parse HEAD)"
if [[ "$resolved" != "$revision" ]]; then
  echo "PocketJS revision mismatch: expected $revision, got $resolved" >&2
  exit 1
fi

if [[ ! -d "$checkout/node_modules" ]]; then
  bun install --cwd "$checkout" --frozen-lockfile
fi

build_root="$(mktemp -d)"
temporary_roots+=("$build_root")
mkdir -p "$build_root/output" "$build_root/package/dist"
bun "$checkout/tools/build.ts" "$plugin_root/src/app.tsx" \
  --framework=solid \
  --no-config \
  --density=1 \
  --hz=60 \
  --outdir="$build_root/output"

bundle="$(find "$build_root/output" -maxdepth 1 -name '*.js' -print -quit)"
assets="$(find "$build_root/output" -maxdepth 1 -name '*.pak' -print -quit)"
test -n "$bundle"
test -n "$assets"
cp "$bundle" "$build_root/package/dist/main.pocketjs"
cp "$assets" "$build_root/package/dist/assets.pak"

bundle_hash="$(shasum -a 256 "$build_root/package/dist/main.pocketjs" | awk '{print $1}')"
assets_hash="$(shasum -a 256 "$build_root/package/dist/assets.pak" | awk '{print $1}')"
cat > "$build_root/package/plugin.toml" <<EOF
id = "dev.warpeer.image-preview"
name = "Image Preview"
description = "Preview local and HTTPS PNG or JPEG images from terminal resources."
version = "1.3.1"
surfaces = ["terminal-hover"]

[[extensions]]
extension = "chrome"
min_version = 1
max_version = 1

[[extensions]]
extension = "resize-transition"
min_version = 1
max_version = 1
optional = true

[[extensions]]
extension = "drag-regions"
min_version = 1
max_version = 1
optional = true

[[triggers]]
type = "terminal-hover"
extensions = ["png", "jpg", "jpeg"]

[[triggers]]
type = "terminal-hover"
schemes = ["https"]

[runtime]
protocol = 1
abi = ">=1.0.0, <2.0.0"
engine = "pocket-surface"
target = "warpeer"

[entrypoints]
bundle = "dist/main.pocketjs"
assets = "dist/assets.pak"

[hashes]
"dist/main.pocketjs" = "$bundle_hash"
"dist/assets.pak" = "$assets_hash"

[publisher]
name = "Warpeer"
identifier = "com.matrixme.warpeer"

[[capabilities]]
capability = "terminal-context"
reason = "Recognize the exact resource under the terminal pointer."

[[capabilities]]
capability = "resource-read"
reason = "Read only the exact local image represented by the active hover context."
scopes = ["exact-image-file"]

[[capabilities]]
capability = "network-fetch"
reason = "Fetch only the exact HTTPS image represented by the active hover context."
optional = true
scopes = ["https-image"]

[[capabilities]]
capability = "pane-surface"
reason = "Present a bounded terminal hover surface without taking focus."

[[capabilities]]
capability = "settings-store"
reason = "Persist Image Preview configuration in the isolated plugin store."

[[settings]]
key = "trigger_mode"
title = "Preview trigger"
description = "Open previews after a stable hover, from the link menu, or with both interactions."
type = "string"
default = "Click menu"
choices = ["Hover", "Click menu", "Both"]

[[settings]]
key = "hover_delay_ms"
title = "Hover delay"
description = "Time a resource must remain stable before preview opens."
type = "integer"
default = 1500
min = 1500
max = 4000
step = 50
unit = "ms"

[[settings]]
key = "max_width"
title = "Maximum width"
description = "Largest decoded preview width."
type = "integer"
default = 560
min = 160
max = 1024
step = 16
unit = "px"

[[settings]]
key = "max_height"
title = "Maximum height"
description = "Largest decoded preview height."
type = "integer"
default = 420
min = 120
max = 1024
step = 20
unit = "px"

[[settings]]
key = "remote_https_enabled"
title = "Remote HTTPS images"
description = "Allow previews for exact HTTPS image links."
type = "boolean"
default = true

[[settings]]
key = "cache_bytes"
title = "Memory cache"
description = "Maximum in-memory decoded preview cache."
type = "integer"
default = 33554432
min = 0
max = 134217728
step = 8388608
unit = "bytes"

[budgets]
memory_bytes = 100663296
execution_slice_ms = 16
queued_messages = 128
active_surfaces = 1
max_surface_pixels = 1048576
max_frame_rate = 60
cache_bytes = 33554432
EOF

mkdir -p "$plugin_root/dist"
find "$build_root/package" -exec touch -t 198001010000 {} +
(
  cd "$build_root/package"
  zip -X -q -r "$plugin_root/dist/image-preview.warpeerplugin" .
)
echo "Built $plugin_root/dist/image-preview.warpeerplugin"
