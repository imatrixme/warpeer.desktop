#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
output_dir="$repo_root/build/warpeer"
final_dmg="$output_dir/Warpeer.dmg"
distribution=false
clean_build="${WARPEER_CLEAN_BUILD:-0}"
max_dmg_bytes="${WARPEER_MAX_DMG_BYTES:-52428800}"

[[ "$max_dmg_bytes" =~ ^[0-9]+$ ]] || {
  echo "error: WARPEER_MAX_DMG_BYTES must be an integer" >&2
  exit 1
}
[[ "$clean_build" =~ ^[01]$ ]] || {
  echo "error: WARPEER_CLEAN_BUILD must be 0 or 1" >&2
  exit 1
}

for argument in "$@"; do
  case "$argument" in
    --distribution) distribution=true ;;
    --clean) clean_build=1 ;;
    -h|--help)
      echo "usage: $0 [--distribution] [--clean]"
      exit 0
      ;;
    *)
      echo "error: unknown option: $argument" >&2
      exit 2
      ;;
  esac
done

run_in_system_terminal() {
  local terminal_base terminal_root command_path log_path result_path result_code argument
  local layout_request_path layout_result_path layout_volume_name layout_mount_path

  terminal_base="${TMPDIR:-/tmp}"
  terminal_base="${terminal_base%/}"
  terminal_root="$(mktemp -d "$terminal_base/warpeer-terminal.XXXXXX")"
  command_path="$terminal_root/build.command"
  log_path="$terminal_root/build.log"
  result_path="$terminal_root/result"
  layout_request_path="$terminal_root/layout-request"
  layout_result_path="$terminal_root/layout-result"

  cleanup_terminal_launcher() {
    rm -rf -- "$terminal_root"
  }
  trap cleanup_terminal_launcher EXIT INT TERM HUP

  {
    printf '#!/bin/zsh\n\n'
    printf 'set -u\n\n'
    printf 'result_code=1\n'
    printf 'finish() {\n'
    printf '  print -r -- "$result_code" > %q\n' "$result_path"
    printf '}\n'
    printf 'trap finish EXIT\n\n'
    [[ -z "${WARPEER_SIGN_IDENTITY:-}" ]] || \
      printf 'export WARPEER_SIGN_IDENTITY=%q\n' "$WARPEER_SIGN_IDENTITY"
    [[ -z "${WARPEER_MAX_DMG_BYTES:-}" ]] || \
      printf 'export WARPEER_MAX_DMG_BYTES=%q\n' "$WARPEER_MAX_DMG_BYTES"
    [[ -z "${WARPEER_CARGO_TARGET_DIR:-}" ]] || \
      printf 'export WARPEER_CARGO_TARGET_DIR=%q\n' "$WARPEER_CARGO_TARGET_DIR"
    [[ -z "${WARPEER_VERSION:-}" ]] || \
      printf 'export WARPEER_VERSION=%q\n' "$WARPEER_VERSION"
    [[ -z "${BUILD_JOBS:-}" ]] || printf 'export BUILD_JOBS=%q\n' "$BUILD_JOBS"
    [[ -z "${ASC_UPLOAD_TIMEOUT:-}" ]] || \
      printf 'export ASC_UPLOAD_TIMEOUT=%q\n' "$ASC_UPLOAD_TIMEOUT"
    printf 'export WARPEER_LAYOUT_REQUEST_PATH=%q\n' "$layout_request_path"
    printf 'export WARPEER_LAYOUT_RESULT_PATH=%q\n' "$layout_result_path"
    printf 'exec > >(tee %q) 2>&1\n' "$log_path"
    printf 'cd %q\n' "$repo_root"
    printf '%q' "$repo_root/script/warpeer/build-dmg"
    for argument in "$@"; do
      printf ' %q' "$argument"
    done
    printf '\nresult_code=$?\n'
    printf 'exit "$result_code"\n'
  } > "$command_path"
  chmod 700 "$command_path"

  echo "[warpeer] Opening the package build in Apple Terminal..."
  open -a Terminal "$command_path"
  while [[ ! -f "$result_path" ]]; do
    if [[ -f "$layout_request_path" && ! -f "$layout_result_path" ]]; then
      layout_volume_name="$(sed -n '1p' "$layout_request_path")"
      layout_mount_path="$(sed -n '2p' "$layout_request_path")"
      if osascript \
        "$repo_root/script/warpeer/layout-dmg.applescript" \
        "$layout_volume_name" \
        "$layout_mount_path"; then
        printf '0\n' > "$layout_result_path"
      else
        printf '1\n' > "$layout_result_path"
      fi
    fi
    sleep 1
  done

  result_code="$(<"$result_path")"
  [[ -f "$log_path" ]] && cat "$log_path"
  [[ "$result_code" =~ ^[0-9]+$ ]] || {
    echo "error: Apple Terminal returned an invalid build status" >&2
    return 1
  }

  cleanup_terminal_launcher
  trap - EXIT INT TERM HUP
  return "$result_code"
}

if [[ "${TERM_PROGRAM:-}" != "Apple_Terminal" ]]; then
  run_in_system_terminal "$@"
  exit $?
fi

target_arch="$(uname -m)"
case "$target_arch" in
  arm64) rust_target="aarch64-apple-darwin" ;;
  x86_64) rust_target="x86_64-apple-darwin" ;;
  *)
    echo "error: unsupported macOS architecture: $target_arch" >&2
    exit 1
    ;;
esac

for command in awk cargo codesign diskutil du find git grep hdiutil mktemp osascript plutil \
  python3 rustc stat strip; do
  command -v "$command" >/dev/null 2>&1 || {
    echo "error: required command not found: $command" >&2
    exit 1
  }
done

tracked_signing_material="$({
  git -C "$repo_root" ls-files | grep -Ei \
    '(^|/)[^/]+\.(p8|p12|mobileprovision|provisionprofile|keychain-db)$'
} || true)"
[[ -z "$tracked_signing_material" ]] || {
  echo "error: signing credentials must not be tracked by Git:" >&2
  echo "$tracked_signing_material" >&2
  exit 1
}

if "$distribution"; then
  for command in asc security spctl xcrun; do
    command -v "$command" >/dev/null 2>&1 || {
      echo "error: required distribution command not found: $command" >&2
      exit 1
    }
  done
  : "${WARPEER_SIGN_IDENTITY:?Set WARPEER_SIGN_IDENTITY to a Developer ID Application identity}"
  [[ "$WARPEER_SIGN_IDENTITY" == Developer\ ID\ Application:* ]] || {
    echo "error: WARPEER_SIGN_IDENTITY must be a Developer ID Application identity" >&2
    exit 1
  }
  security find-identity -v -p codesigning | grep -F "$WARPEER_SIGN_IDENTITY" >/dev/null || {
    echo "error: Developer ID identity is not available in the current keychain" >&2
    exit 1
  }
  asc auth status >/dev/null
fi

git -C "$repo_root" check-ignore -q build/ || {
  echo "error: build/ must remain ignored by .gitignore" >&2
  exit 1
}

layout_script="$repo_root/script/warpeer/layout-dmg.applescript"
[[ -f "$layout_script" ]] || {
  echo "error: required DMG layout script not found: $layout_script" >&2
  exit 1
}

temp_root="${TMPDIR:-/tmp}"
temp_root="${temp_root%/}"
work_root="$(mktemp -d "$temp_root/warpeer-dmg.XXXXXX")"
case "$work_root" in
  "$temp_root"/warpeer-dmg.*) ;;
  *)
    echo "error: unexpected temporary directory: $work_root" >&2
    exit 1
    ;;
esac

layout_mount_dir=""
cleanup() {
  local exit_code=$?
  trap - EXIT INT TERM HUP
  if [[ -n "$layout_mount_dir" ]]; then
    hdiutil detach "$layout_mount_dir" -force >/dev/null 2>&1 || true
  fi
  rm -rf -- "$work_root"
  echo "[warpeer] Removed temporary packaging products."
  exit "$exit_code"
}
trap cleanup EXIT
trap 'exit 130' INT
trap 'exit 143' TERM
trap 'exit 129' HUP

if [[ "$clean_build" == "1" ]]; then
  export CARGO_TARGET_DIR="$work_root/target"
  echo "[warpeer] Using an isolated clean Cargo target."
else
  export CARGO_TARGET_DIR="${WARPEER_CARGO_TARGET_DIR:-$repo_root/target/warpeer-package}"
  mkdir -p "$CARGO_TARGET_DIR"
  echo "[warpeer] Reusing Cargo target cache at $CARGO_TARGET_DIR."
fi
export MACOSX_DEPLOYMENT_TARGET="10.14"
profile="release-warpeer"
bundle_dir="$CARGO_TARGET_DIR/$profile/bundle/osx"
built_app_path="$bundle_dir/Warpeer.app"
app_path="$work_root/Warpeer.app"
logical_cpus="$(sysctl -n hw.logicalcpu)"
default_jobs=$((logical_cpus > 0 ? logical_cpus : 1))
export CARGO_BUILD_JOBS="${BUILD_JOBS:-$default_jobs}"

"$repo_root/script/warpeer/sync-ghostty-themes" --check
"$repo_root/script/warpeer/sync-pocketjs" --check

IFS=$'\t' read -r version version_patch < <("$repo_root/script/warpeer/version" next)
export GIT_RELEASE_TAG="$version"

echo "[warpeer] Building Warpeer $version for $rust_target..."
rm -rf -- "$built_app_path"
(
  cd "$repo_root/app"
  cargo bundle \
    --format osx \
    --profile "$profile" \
    --bin warpeer \
    --no-default-features \
    --features warpeer
)

[[ -d "$built_app_path" ]] || {
  echo "error: app bundle not found: $built_app_path" >&2
  exit 1
}
ditto "$built_app_path" "$app_path"

binary_path="$app_path/Contents/MacOS/warpeer"
"$repo_root/script/macos/add_framework_rpath" "$binary_path"
strip -S -x "$binary_path"

resources_dir="$app_path/Contents/Resources"
plutil -replace CFBundleShortVersionString -string "$version" "$app_path/Contents/Info.plist"
plutil -replace CFBundleVersion -string "$version_patch" "$app_path/Contents/Info.plist"

# Warpeer intentionally packages a resource allowlist. Agent skills, MCP skills,
# onboarding, and settings-schema artifacts belong to the full Warp product.
rm -rf -- "$resources_dir/bundled"
mkdir -p "$resources_dir/bundled/metadata"
git_release_tag="$(git -C "$repo_root" rev-parse --short HEAD)"
printf '{\n  "warp_version": "%s",\n  "product": "Warpeer"\n}\n' "$git_release_tag" \
  > "$resources_dir/bundled/metadata/version.json"

for forbidden_resource in skills mcp_skills; do
  [[ ! -e "$resources_dir/bundled/$forbidden_resource" ]] || {
    echo "error: forbidden resource was packaged: $forbidden_resource" >&2
    exit 1
  }
done


bundled_signing_material="$(find "$app_path" -type f \( \
  -iname '*.p8' -o \
  -iname '*.p12' -o \
  -iname '*.mobileprovision' -o \
  -iname '*.provisionprofile' -o \
  -iname '*.keychain-db' \
\) -print -quit)"
[[ -z "$bundled_signing_material" ]] || {
  echo "error: signing credentials were copied into the app bundle" >&2
  exit 1
}

signing_identity="-"
if "$distribution"; then
  signing_identity="$WARPEER_SIGN_IDENTITY"
  codesign --force --deep --options runtime --timestamp \
    --sign "$signing_identity" \
    --entitlements "$repo_root/script/warpeer/Release-Entitlements.plist" \
    "$app_path"
else
  codesign --force --deep --options runtime \
    --sign "$signing_identity" \
    --entitlements "$repo_root/script/warpeer/Release-Entitlements.plist" \
    "$app_path"
fi
codesign --verify --deep --strict "$app_path"

staging_dir="$work_root/staging"
mkdir -p "$staging_dir"
ditto "$app_path" "$staging_dir/Warpeer.app"
ln -s /Applications "$staging_dir/Applications"

temporary_dmg="$work_root/Warpeer.dmg"
layout_dmg="$work_root/Warpeer-layout.dmg"
layout_mount_dir="$work_root/WarpeerBuild-$$"
layout_volume_name="Warpeer Build $$"
staging_kib="$(du -sk "$staging_dir" | awk '{print $1}')"
layout_kib=$((staging_kib + staging_kib / 4 + 65536))
echo "[warpeer] Creating $final_dmg..."
hdiutil create \
  -ov \
  -format UDRW \
  -fs APFS \
  -size "${layout_kib}k" \
  -volname "$layout_volume_name" \
  -srcfolder "$staging_dir" \
  "$layout_dmg"
mkdir -p "$layout_mount_dir"
hdiutil attach \
  -readwrite \
  -noverify \
  -noautoopen \
  -mountpoint "$layout_mount_dir" \
  "$layout_dmg" >/dev/null

# Finder can time out while registering the full app during scripted layout.
# The saved icon position is keyed by filename, so keep the payload off-volume until the window closes.
layout_app_payload="$work_root/Warpeer-layout-payload.app"
mv "$layout_mount_dir/Warpeer.app" "$layout_app_payload"
mkdir "$layout_mount_dir/Warpeer.app"
if [[ -n "${WARPEER_LAYOUT_REQUEST_PATH:-}" && -n "${WARPEER_LAYOUT_RESULT_PATH:-}" ]]; then
  printf '%s\n%s\n' "$(basename "$layout_mount_dir")" "$layout_mount_dir" \
    > "$WARPEER_LAYOUT_REQUEST_PATH"
  while [[ ! -f "$WARPEER_LAYOUT_RESULT_PATH" ]]; do
    sleep 1
  done
  layout_result_code="$(<"$WARPEER_LAYOUT_RESULT_PATH")"
  [[ "$layout_result_code" == 0 ]] || {
    echo "error: delegated Finder layout failed" >&2
    exit 1
  }
else
  osascript "$layout_script" "$(basename "$layout_mount_dir")" "$layout_mount_dir"
fi
[[ -f "$layout_mount_dir/.DS_Store" ]] || {
  echo "error: Finder did not persist the DMG layout" >&2
  exit 1
}
rmdir "$layout_mount_dir/Warpeer.app"
mv "$layout_app_payload" "$layout_mount_dir/Warpeer.app"
diskutil rename "$layout_mount_dir" Warpeer >/dev/null
sync
hdiutil detach "$layout_mount_dir" >/dev/null
layout_mount_dir=""
hdiutil convert \
  "$layout_dmg" \
  -format ULMO \
  -o "$temporary_dmg" >/dev/null
hdiutil verify "$temporary_dmg"
if "$distribution"; then
  codesign --force --timestamp --sign "$signing_identity" "$temporary_dmg"
else
  codesign --force --sign "$signing_identity" "$temporary_dmg"
fi
codesign --verify --strict "$temporary_dmg"

if "$distribution"; then
  ASC_UPLOAD_TIMEOUT="${ASC_UPLOAD_TIMEOUT:-5m}" \
    asc notarization submit \
      --file "$temporary_dmg" \
      --wait \
      --timeout 1h \
      --output table
  xcrun stapler staple "$temporary_dmg"
  xcrun stapler validate "$temporary_dmg"
  spctl --assess --type execute --verbose=4 "$app_path"
  spctl --assess \
    --type open \
    --context context:primary-signature \
    --verbose=4 \
    "$temporary_dmg"
fi

dmg_bytes="$(stat -f '%z' "$temporary_dmg")"
binary_bytes="$(stat -f '%z' "$binary_path")"
app_kib="$(du -sk "$app_path" | awk '{print $1}')"
app_bytes=$((app_kib * 1024))
((dmg_bytes <= max_dmg_bytes)) || {
  echo "error: Warpeer.dmg is $dmg_bytes bytes; limit is $max_dmg_bytes bytes" >&2
  exit 1
}

mkdir -p "$output_dir"
rm -f -- "$final_dmg"
mv "$temporary_dmg" "$final_dmg"

echo "[warpeer] Done: $final_dmg"
echo "[warpeer] Executable size: $binary_bytes bytes"
echo "[warpeer] App size: $app_bytes bytes"
echo "[warpeer] DMG size: $dmg_bytes bytes"
shasum -a 256 "$final_dmg"
