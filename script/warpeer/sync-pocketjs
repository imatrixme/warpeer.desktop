#!/usr/bin/env bash

set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
vendor_root="$repo_root/third_party/pocketjs"
revision="$(tr -d '[:space:]' < "$vendor_root/PINNED_REVISION")"
source_url="https://github.com/pocket-stack/pocketjs.git"

if [[ "${1:-}" == "--check" ]]; then
  test -f "$vendor_root/LICENSE"
  test -f "$vendor_root/engine/core/src/lib.rs"
  test -f "$vendor_root/engine/crates/pocket-mod/src/lib.rs"
  test -f "$vendor_root/engine/crates/pocket-ui-surface/src/lib.rs"
  test -f "$vendor_root/engine/apple/src/lib.rs"
  if git -C "$repo_root" apply --reverse --check --directory=third_party/pocketjs \
    "$vendor_root/patches/apple-host-bridge.patch" 2>/dev/null; then
    exit 0
  fi

  # rustfmt may rewrite patched Rust without changing the bridge ABI. In that
  # case a reverse patch is too brittle, so prove the patch is not missing and
  # validate every symbol the repository-owned adapter links against.
  if git -C "$repo_root" apply --check --directory=third_party/pocketjs \
    "$vendor_root/patches/apple-host-bridge.patch" 2>/dev/null; then
    echo "PocketJS Apple host bridge patch is not applied" >&2
    exit 1
  fi
  rg --quiet --fixed-strings -- 'MAX_EXTERNAL_TEXTURE_BYTES' \
    "$vendor_root/engine/apple/src/lib.rs" || {
    echo "PocketJS Apple host bridge is missing its texture budget" >&2
    exit 1
  }
  rg --quiet --fixed-strings -- 'upload_external_rgba_texture' \
    "$vendor_root/engine/core/src/lib.rs" || {
    echo "PocketJS host bridge is missing non-power-of-two external textures" >&2
    exit 1
  }
  for marker in \
    'pocket_apple_resize' \
    'pocket_apple_upload_rgba' \
    'pocket_apple_free_texture'
  do
    rg --quiet --fixed-strings -- "$marker" "$vendor_root/engine/apple/src/lib.rs" || {
      echo "PocketJS Apple host bridge is missing $marker" >&2
      exit 1
    }
  done
  exit 0
fi

checkout="$(mktemp -d)"
trap 'rm -rf -- "$checkout"' EXIT

git clone --filter=blob:none --no-checkout "$source_url" "$checkout/source"
git -C "$checkout/source" fetch --depth 1 origin "$revision"
git -C "$checkout/source" checkout --detach "$revision"

resolved="$(git -C "$checkout/source" rev-parse HEAD)"
if [[ "$resolved" != "$revision" ]]; then
  echo "PocketJS revision mismatch: expected $revision, got $resolved" >&2
  exit 1
fi

cp "$checkout/source/LICENSE" "$vendor_root/LICENSE"
for relative_path in core crates/pocket-mod crates/pocket-ui-surface apple; do
  mkdir -p "$vendor_root/engine/$relative_path"
  rsync -a --delete --exclude Cargo.toml --exclude Cargo.lock --exclude target \
    "$checkout/source/engine/$relative_path/" \
    "$vendor_root/engine/$relative_path/"
done

git -C "$repo_root" apply --directory=third_party/pocketjs \
  "$vendor_root/patches/apple-host-bridge.patch"

echo "PocketJS runtime synchronized at $revision"
