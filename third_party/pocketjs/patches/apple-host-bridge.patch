+
+    /// Upload host-owned RGBA pixels without the packaged-asset power-of-two
+    /// constraint. The host is responsible for applying its own byte and
+    /// dimension budgets before calling this entry point.
+    pub fn upload_external_rgba_texture(&mut self, data: &[u8], w: u32, h: u32) -> i32 {
+        let Some(byte_len) = (w as usize)
+            .checked_mul(h as usize)
+            .and_then(|pixels| pixels.checked_mul(4))
+        else {
+            return -1;
+        };
+        if w == 0 || h == 0 || data.len() != byte_len {
+            return -1;
+        }
+
+        let texture = Texture {
+            data: copy_aligned(data, byte_len),
+            byte_len,
+            w,
+            h,
+            psm: spec::psm::PSM_8888,
+            palette: None,
+            linear: false,
+            revision: 0,
+        };
+        let handle = tex_alloc(&mut self.textures, &mut self.tex_free, texture);
+        if handle >= 0 {
+            self.bump_raster_revision();
+        }
+        handle
+    }
 
