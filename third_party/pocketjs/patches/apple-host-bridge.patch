+/// Resize the logical viewport while retaining the guest and UI tree. The
+/// next render is forced to repaint the complete new framebuffer.
+#[unsafe(no_mangle)]
+pub extern "C" fn pocket_apple_resize(
+    handle: *mut PocketApple,
+    logical_width: u32,
+    logical_height: u32,
+) -> i32 {
+    with_handle(handle, ERR_PANIC, |state| {
+        if !state.mounted || logical_width == 0 || logical_height == 0 {
+            set_last_error("invalid resize state or viewport");
+            return ERR_BAD_ARGUMENT;
         }
+        let pixel_len = logical_width as usize
+            * state.density as usize
+            * logical_height as usize
+            * state.density as usize
+            * 4;
+        state.logical_width = logical_width;
+        state.logical_height = logical_height;
+        state.framebuffer.resize(pixel_len, 0);
+        state
+            .surface
+            .with_ui(|ui| ui.set_viewport(logical_width as f32, logical_height as f32));
+        state.tracker.invalidate();
+        OK
     })
 }
 
+/// Upload an RGBA8 texture owned by the host and return the opaque PocketJS
+/// texture handle. The guest receives the handle over its normal service
+/// channel and decides which Image node should display it.
 #[unsafe(no_mangle)]
+pub extern "C" fn pocket_apple_upload_rgba(
+    handle: *mut PocketApple,
+    pixels: *const u8,
+    length: usize,
+    width: u16,
+    height: u16,
+) -> i32 {
+    with_handle(handle, ERR_PANIC, |state| {
+        if !state.mounted {
+            set_last_error("texture upload before eval_bundle");
+            return ERR_BAD_STATE;
+        }
+        let expected = width as usize * height as usize * 4;
+        if pixels.is_null()
+            || width == 0
+            || height == 0
+            || length != expected
+            || length > MAX_EXTERNAL_TEXTURE_BYTES
+        {
+            set_last_error("invalid RGBA texture dimensions or byte length");
+            return ERR_BAD_ARGUMENT;
+        }
+        let pixels = unsafe { slice::from_raw_parts(pixels, length) };
+        let texture = state.surface.with_ui(|ui| {
+            ui.upload_external_rgba_texture(pixels, u32::from(width), u32::from(height))
+        });
+        if texture < 0 {
+            set_last_error("PocketJS rejected RGBA texture");
+            return ERR_BAD_ARGUMENT;
+        }
+        texture
+    })
+}
+
+/// Release an opaque texture handle previously returned by
+/// [`pocket_apple_upload_rgba`]. Stale handles are harmless no-ops.
+#[unsafe(no_mangle)]
+pub extern "C" fn pocket_apple_free_texture(handle: *mut PocketApple, texture: i32) -> i32 {
+    with_handle(handle, ERR_PANIC, |state| {
+        if !state.mounted {
+            set_last_error("texture release before eval_bundle");
+            return ERR_BAD_STATE;
+        }
+        state.surface.with_ui(|ui| ui.free_texture(texture));
+        OK
+    })
+}
