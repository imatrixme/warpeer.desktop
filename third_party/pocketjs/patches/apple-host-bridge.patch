 #[test]
+fn external_rgba_texture_accepts_non_power_of_two_dimensions() {
+    let mut ui = Ui::new();
+    let pixels = alloc::vec![0x80u8; 17 * 13 * 4];
+
+    assert_eq!(ui.upload_texture(&pixels, 17, 13, spec::psm::PSM_8888), -1);
+    let texture = ui.upload_external_rgba_texture(&pixels, 17, 13);
+    assert!(texture >= 0);
+    let view = ui.texture(texture).unwrap();
+    assert_eq!((view.pixels.len(), view.w, view.h), (pixels.len(), 17, 13));
+    assert_eq!(ui.upload_external_rgba_texture(&pixels[..4], 17, 13), -1);
+}
